//profile.cshtml
@model part3_mvc_consume.Models.ProfileViewModel
<div class="crumb">RACEDAY / PARTICIPANT</div>
<h1>My profile</h1>
<div id="profileMessage"></div>
<div class="card">
    <form id="profileForm" asp-action="SaveProfile" method="post">
        <label>Name</label><input asp-for="Name" required /><span asp-validation-for="Name" class="text-danger"></span>
        <label>Surname</label><input asp-for="Surname" required /><span asp-validation-for="Surname" class="text-danger"></span>
        <label>Age</label><input asp-for="Age" type="number" required /><span asp-validation-for="Age" class="text-danger"></span>
        <button class="btn" type="submit">Save profile</button>
    </form>
</div>
