//Enrol.cshtml
@model part3_mvc_consume.Models.Enrolments
<div class="crumb">RACEDAY / PARTICIPANT</div>
<h1>Enrol in Event</h1>
@if (ViewBag.Message != null)
{
    <div class="toast" style="position:static;transform:none">@ViewBag.Message</div>
}
<div class="card">
    <form asp-action="Enrol" method="post">
        <label>Event ID</label><input asp-for="eventID" required />
        <label>Category ID</label><input asp-for="categoryID" required />
        <label>Enrolment Date</label><input asp-for="enrolmemtDate" type="date" required />
        <label>Status</label><input asp-for="status" value="Active" required />
        <button class="btn" type="submit">Enrol</button>
    </form>
</div>

